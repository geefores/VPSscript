#!/bin/bash
# Saugumo pataisymas Ubuntu 24.04:
# senoji versija nustatydavo iptables politika ACCEPT ir isvalydavo visas taisykles.
# Kol nera saugaus, konkreciai tikslui skirto taisykliu valdymo, nieko nekeiciame.
clear 2>/dev/null || true
printf '\033[1;31mSSHPLUS: ugniasienes taisykliu valymas isjungtas saugumo sumetimais.\033[0m\n'
printf 'Senoji funkcija galejo panaikinti VPS ugniasienes apsauga.\n'
printf 'Esamos iptables taisykles nepakeistos.\n'
exit 2
