#!/bin/bash
# SSHPLUS updater check — safe staged version.
# Automatic execution of Plus is intentionally disabled until the installer
# and every module have completed a security review.

clear 2>/dev/null || true
BASE_URL="https://raw.githubusercontent.com/geefores/VPSscript/main/SSHPLUSsocks/Install/versao"
TMP_VERSION="$(mktemp /tmp/sshplus-versao.XXXXXX)" || exit 1
trap 'rm -f "$TMP_VERSION"' EXIT

echo ""
echo -e "                              \033[1;31mBy @DEINTERNET\033[1;36m"
if command -v figlet >/dev/null 2>&1; then
  figlet "SSHPlus"
else
  echo "SSHPlus"
fi
echo ""
echo -e "   \033[1;32mTIKRINAMI GALIMI VPS ATNAUJINIMAI, PALAUKITE\033[0m\n"

if ! command -v curl >/dev/null 2>&1; then
  echo "KLAIDA: curl neįdiegtas; atnaujinimų patikrinti negalima."
elif ! curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    --connect-timeout 8 --max-time 20 "$BASE_URL" -o "$TMP_VERSION"; then
  echo "KLAIDA: nepavyko saugiai atsisiųsti versijos informacijos iš GitHub."
elif [[ ! -s "$TMP_VERSION" ]] || ! grep -q '[0-9]' "$TMP_VERSION"; then
  echo "KLAIDA: GitHub pateikta versijos informacija tuščia arba netinkama."
elif [[ ! -s /bin/versao ]]; then
  echo "KLAIDA: nerastas vietinis /bin/versao. Nieko netrinu ir nekeičiu."
else
  local_version="$(sed -n '1p' /bin/versao | tr -cd '0-9')"
  remote_version="$(sed -n '1p' "$TMP_VERSION" | tr -cd '0-9')"
  if [[ -z "$local_version" || -z "$remote_version" ]]; then
    echo "KLAIDA: nepavyko patikimai perskaityti versijos numerio."
  elif [[ "$local_version" == "$remote_version" ]]; then
    echo -e " \033[1;36mVPS SKRIPTAS JAU ATNAUJINTAS.\033[0m"
  else
    echo -e " \033[1;33mRASTAS KITAS VPS SKRIPTO VERSIJOS NUMERIS.\033[0m"
    cat "$TMP_VERSION"
    echo ""
    echo "Automatinis atnaujinimas laikinai išjungtas, kol patikrinami Plus ir moduliai."
    echo "Nieko neatsisiunčiau vykdymui ir nepakeičiau sistemos failų."
  fi
fi

echo ""
if declare -F menu >/dev/null 2>&1; then
  read -r -p "Spauskite ENTER, kad grįžtumėte į meniu... " _
  menu
else
  echo "Patikra baigta. Grįžkite į meniu rankiniu būdu."
fi
