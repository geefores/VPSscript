_row() {
  local _color="$1" _text="$2" _plain _len _space
  _plain=$(printf '%s' "$_text" | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g')
  _len=${#_plain}
  if [ "$_len" -gt "$_content" ]; then _plain="${_plain:0:$_content}"; _len=$_content; fi
  _space=$((_content - _len))
  printf '%s%b| %s%*s |%b\n' "$_prefix" "$_color" "$_plain" "$_space" '' "$C_RESET"
}

_section() {
  local _color="$1" _label="$2" _fill
  _fill=$((_inner - ${#_label} - 4))
  [ "$_fill" -ge 1 ] || _fill=1
  printf '%s%b+-- %s %s+%b\n' "$_prefix" "$_color" "$_label" "$(printf '%*s' "$_fill" '' | tr ' ' '-')" "$C_RESET"
}

_menurow() {
  local _an="$1" _al="$2" _bn="$3" _bl="$4"
  local _left_width _right_width _left_label_width _right_label_width
  local _left_label _right_label _rowcolor

  # Stulpeliai apskaičiuojami pagal terminalo plotį, kad rėmelis nesikreivintų.
  if [ "$_cols" -ge 48 ]; then
    _left_width=$(((_content - 5) / 2))
    _right_width=$((_content - 5 - _left_width))
    _left_label_width=$((_left_width - 5))
    _right_label_width=$((_right_width - 5))
    [ "$_left_label_width" -lt 1 ] && _left_label_width=1
    [ "$_right_label_width" -lt 1 ] && _right_label_width=1

    _left_label=$(printf '%-*.*s' "$_left_label_width" "$_left_label_width" "$_al")
    _right_label=$(printf '%-*.*s' "$_right_label_width" "$_right_label_width" "$_bl")
    _rowcolor="$C_TEXT"
    case "$_an" in 02|04|06|08|10) _rowcolor="$C_MENU_ALT" ;; esac

    # Numeriai spalvinami atskirai; tekstas lieka įskaitomas, abi pusės vienodo pločio.
    printf '%s%b| %b[%s]%b %-*s %b[%s]%b %-*s |%b\n' \
      "$_prefix" "$C_BORDER" \
      "$C_NUMBER" "$_an" "$_rowcolor" "$((_left_label_width))" "$_left_label" \
      "$C_NUMBER" "$_bn" "$C_TEXT" "$((_right_label_width))" "$_right_label" "$C_RESET"
  else
    # Siaurame telefone rodyti po vieną pilno pločio eilutę, neardant rėmelio.
    _row "$C_NUMBER" "[$_an] $_al"
    _row "$C_NUMBER" "[$_bn] $_bl"
  fi
}
_center_line() {
  local _text="$1" _pad _right
  [ "${#_text}" -gt "$_content" ] && _text="${_text:0:_content}"
  _pad=$(((_content - ${#_text}) / 2))
  _right=$((_content - _pad - ${#_text}))
  printf '%s%b|%*s%s%*s|%b\n' "$_prefix" "$C_BORDER" "$_pad" '' "$_text" "$_right" '' "$C_RESET"
}

