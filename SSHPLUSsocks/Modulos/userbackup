#!/bin/bash
# SSHPLUS user backup utility.
# Backups contain sensitive account data and must remain local/root-readable.
set -u
clear
backbot="${1:-}"

if [[ -z "$backbot" ]]; then
    echo -e "\E[44;1;37m             Atsarginiu kopiju valdymas              \E[0m"
    echo ""
    echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mSUKURTI BACKUP"
    echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mATSTATYTI BACKUP"
    echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mGRIZTI\033[1;37m"
    echo ""
    echo -ne "\033[1;32mKA NORITE DARYTI\033[1;31m ?\033[1;37m : "
    read -r opcao

    if [[ "$opcao" == "1" ]]; then
        umask 077
        tmp_backup="$(mktemp /root/.backup.vps.XXXXXX)" || {
            echo "Nepavyko sukurti laikino atsarginės kopijos failo."
            exit 1
        }

        if [[ -f /root/usuarios.db ]]; then
            tar -cf "$tmp_backup" \
                /root/usuarios.db /etc/shadow /etc/passwd /etc/group \
                /etc/gshadow /etc/SSHPlus/senha 2>/dev/null
        else
            tar -cf "$tmp_backup" \
                /etc/shadow /etc/passwd /etc/group /etc/gshadow \
                /etc/SSHPlus/senha 2>/dev/null
        fi

        if [[ $? -ne 0 || ! -s "$tmp_backup" ]]; then
            rm -f -- "$tmp_backup"
            echo -e "\033[1;31mAtsarginės kopijos sukurti nepavyko.\033[0m"
            exit 1
        fi

        chown root:root "$tmp_backup"
        chmod 0600 "$tmp_backup"
        mv -f -- "$tmp_backup" /root/backup.vps
        chmod 0600 /root/backup.vps

        echo ""
        echo -e "\033[1;32mBACKUP SUKURTAS SEKMINGAI!\033[0m"
        echo -e "\033[1;33mFailas saugomas tik serveryje: /root/backup.vps\033[0m"
        echo -e "\033[1;31mSaugumo sumetimais atsisiuntimo nuoroda per viešą HTTP nebekuriama.\033[0m"
        echo ""
    elif [[ "$opcao" == "2" ]]; then
        if [[ -f /root/backup.vps && ! -L /root/backup.vps ]]; then
            echo ""
            echo -e "\033[1;36mAtkuriama atsargine kopija...\033[0m"
            /bin/sshplus-safe-restore --profile users /root/backup.vps || {
                echo -e "\033[1;31mAtkūrimas sustabdytas: archyvas netinkamas arba atkūrimas nepavyko.\033[0m"
                exit 1
            }
            echo ""
            echo -e "\033[1;36mVartotojai ir slaptažodžiai importuoti.\033[0m"
        else
            echo -e "\033[1;33mFailas /root/backup.vps nerastas arba yra nesaugus.\033[0m"
            exit 1
        fi
    elif [[ "$opcao" == "3" ]]; then
        menu
    fi
else
    umask 077
    tmp_backup="$(mktemp /root/.backup.vps.XXXXXX)" || exit 1
    if tar -cf "$tmp_backup" \
        /root/usuarios.db /etc/shadow /etc/passwd /etc/group \
        /etc/gshadow /etc/bot /etc/SSHPlus/senha 2>/dev/null; then
        chown root:root "$tmp_backup"
        chmod 0600 "$tmp_backup"
        if [[ -d /etc/SSHPlus/backups ]]; then
            mv -f -- "$tmp_backup" /etc/SSHPlus/backups/backup.vps
            chown root:root /etc/SSHPlus/backups/backup.vps
            chmod 0600 /etc/SSHPlus/backups/backup.vps
        else
            mv -f -- "$tmp_backup" /root/backup.vps
            chmod 0600 /root/backup.vps
        fi
    else
        rm -f -- "$tmp_backup"
        exit 1
    fi
    exit
fi
