#!/bin/bash
clear
[[ "$(whoami)" != "root" ]] && {
echo -e "\033[1;33m[\033[1;31mKlaida\033[1;33m] \033[1;37m- \033[1;33mreikia paleisti kaip root\033[0m"
rm $HOME/Plus > /dev/null 2>&1; exit 0
}

# Ubuntu 24.04 compatibility guard. This installer must be tested on a disposable VPS first.
if [[ ! -r /etc/os-release ]]; then
  echo "Klaida: nepavyko nustatyti operacines sistemos." >&2
  exit 1
fi
. /etc/os-release
if [[ "${ID:-}" != "ubuntu" || "${VERSION_ID:-}" != "24.04" ]]; then
  echo "Klaida: si versija pritaikoma Ubuntu 24.04 LTS; apt aptarnavimo darbai neatliekami." >&2
  exit 1
fi

# Official source for this repository. Keep the existing directory layout unchanged.
GITHUB_RAW="https://raw.githubusercontent.com/geefores/VPSscript/main/SSHPLUSsocks"
GITHUB_INSTALL="${GITHUB_RAW}/Install"
GITHUB_MODULES="${GITHUB_RAW}/Modulos"
_lnk=$(echo 'z1:y#x.5s0ul&p4hs$s.0a72d*n-e!v89e032:3r'| sed -e 's/[^a-z.]//ig'| rev); _Ink=$(echo '/3×u3#s87r/l32o4×c1a×l1/83×l24×i0b×'|sed -e 's/[^a-z/]//ig'); _1nk=$(echo '/3×u3#s×87r/83×l2×4×i0b×'|sed -e 's/[^a-z/]//ig')
cd $HOME
fun_bar () {
comando[0]="$1"
comando[1]="$2"
(
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
) > /dev/null 2>&1 &
tput civis
echo -ne "  \033[1;33mPALAUKITE \033[1;37m- \033[1;33m["
while true; do
for((i=0; i<18; i++)); do
echo -ne "\033[1;31m#"
sleep 0.1s
done
[[ -e $HOME/fim ]] && rm $HOME/fim && break
echo -e "\033[1;33m]"
sleep 1s
tput cuu1
tput dl1
echo -ne "  \033[1;33mPALAUKITE \033[1;37m- \033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
tput cnorm
}
function verif_key () {
krm=$(echo '5:q-3gs2.o7%8:1'|rev); chmod +x $_Ink/list > /dev/null 2>&1
[[ ! -e "$_Ink/list" ]] && {
echo -e "\n\033[1;31mBLOGAS RAKTAS!\033[0m"
rm -rf $HOME/Plus > /dev/null 2>&1
sleep 2
clear; exit 1
}
}
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "SVEIKI ATVYKE I SOCKS SSHPLUS MANAGER" ; tput sgr0
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo ""
echo -e "             \033[1;31mDEMESIO! \033[1;33mPRADEDAMAS SKRIPTO DIEGIMAS !\033[0m"
echo ""
echo -e "\033[1;31m• \033[1;33mBUS DIEGIAMAS IRANKIU RINKINYS\033[0m"
echo -e "\033[1;33m  TINKLO, SISTEMOS IR VARTOTOJU VALDYMUI\033[0m"
echo ""
echo -e "\033[1;32m• \033[1;32mSVARBU! \033[1;33mPASIRINKITE TERMINALO TAMSIA TEMA\033[0m"
echo -e "\033[1;33m  GERIAU MATOMAS VAIZDAS IR KOMANDOS!\033[0m"
echo ""
echo -e "\033[1;31m≠×≠×≠×≠×≠×≠×≠×[\033[1;33m • \033[1;32mREDAGUOTA BY: @DEINTERNET VPS GROUP\033[1;33m •\033[1;31m ]≠×≠×≠×≠×≠×≠×≠×\033[0m"
echo ""
#-----------------------------------------------------------------------------------------------------------------
echo -ne "\033[1;36mNORITE GENERUOTI SKRIPTO NEMOKAMA RAKTA [N/S]: \033[1;37m"; read x
[[ $x = @(n|N) ]] && exit
# Preserve the server's current SSH port and configuration.
echo -e "\n\033[1;36mTIKRINAMA... \033[1;37m GitHub\033[0m"
rm -f "$_Ink/list"
if ! wget -qO "$_Ink/list" "${GITHUB_INSTALL}/list"; then
  echo "Klaida: nepavyko atsisiusti Install/list is GitHub." >&2
  exit 1
fi
if [[ ! -s "$_Ink/list" ]] || ! head -n 1 "$_Ink/list" | grep -q '^#!/'; then
  echo "Klaida: Install/list tuscias arba netinkamas; nevykdoma." >&2
  rm -f "$_Ink/list"
  exit 1
fi
verif_key
sleep 3s
echo "/bin/menu" > /bin/h && chmod +x /bin/h > /dev/null 2>&1
rm versao* > /dev/null 2>&1
wget -qO "${HOME}/versao" "${GITHUB_INSTALL}/versao" >/dev/null 2>&1 || true
# Removed third-party IP-logger request; it is unrelated to installation.
cd /bin/ > /dev/null 2>&1
rm v2raymanager > /dev/null 2>&1
wget -qO /bin/v2raymanager "${GITHUB_MODULES}/v2raymanager"
chmod 755 /bin/v2raymanager > /dev/null 2>&1
cd > /dev/null 2>&1
#-----------------------------------------------------------------------------------------------------------------
echo -e "\n\033[1;32mRAKTAS SUGENERUOTAS IR PATVIRTINIAS!\033[1;32m"
sleep 1s
echo ""
[[ -f "$HOME/usuarios.db" ]] && {
clear
echo -e "\n\033[0;34m═════════════════════════════════════════════════\033[0m"
echo ""
echo -e "                 \033[1;33m• \033[1;31mDEMESIO \033[1;33m• \033[0m"
echo ""
echo -e "\033[1;33mRasta vartotoju duomenu baze \033[1;32m(usuarios.db) \033[1;33m"
echo -e "Norite ja islaikyti ir naudoti issaugojant visus ribojimus"
echo -e "Ar norite sukurti nauja duomenu baze ?\033[0m"
echo -e "\n\033[1;37m[\033[1;31m1\033[1;37m] \033[1;33mIslaikyti ir issaugoti dabartine duomenu baze\033[0m"
echo -e "\033[1;37m[\033[1;31m2\033[1;37m] \033[1;33mSukurti nauja duomenu baze\033[0m"
echo -e "\n\033[0;34m═════════════════════════════════════════════════\033[0m"
echo ""
tput setaf 2 ; tput bold ; read -p "Ka norite daryti ?: " -e -i 1 optiondb ; tput sgr0
} || {
awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
}
[[ "$optiondb" = '2' ]] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%35s%s%-18s\n' " PALAUKITE VYKSTA SKRIPTO DIEGIMAS" ; tput sgr0
echo ""
echo ""
echo -e "          \033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mATNAUJINAMA SISTEMA \033[1;33m[\033[1;31m!\033[1;33m]\033[0m"
echo ""
echo -e "    \033[1;33mVPS ATNAUJINIAI UZTRUNKIA, PALAUKITE!\033[0m"
echo ""
fun_attlist () {
apt-get update -y
[[ ! -d /usr/share/.plus ]] && mkdir /usr/share/.plus
echo "crz: $(date)" > /usr/share/.plus/.plus
}
fun_bar 'fun_attlist'
clear
echo ""
echo -e "          \033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mVYKSTA PAKETU DIEGIMAS \033[1;33m[\033[1;31m!\033[1;33m] \033[0m"
echo ""
echo -e "\033[1;33mKAI KURIE PAKETAI YPAC REIKALINGI !\033[0m"
echo ""
inst_pct () {
_pacotes=("bc" "screen" "nano" "unzip" "lsof" "net-tools" "dos2unix" "nload" "jq" "curl" "figlet" "python3" "python3-pip" "python3-venv" "ca-certificates" "git")
for _prog in ${_pacotes[@]}; do
apt install $_prog -y
done
# Ubuntu 24.04 marks the system Python as externally managed (PEP 668).
python3 -m venv /opt/sshplus-venv
/opt/sshplus-venv/bin/python -m pip install --upgrade pip
/opt/sshplus-venv/bin/python -m pip install speedtest-cli
}
fun_bar 'inst_pct'
if command -v ufw >/dev/null 2>&1; then
  ufw allow 443/tcp
  ufw allow 80/tcp
  ufw allow 3128/tcp
  ufw allow 8799/tcp
  ufw allow 8080/tcp
fi
clear
echo ""
echo -e "              \033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mBAIGIAMAS SKRIPTO DIEGIMAS, PALAUKITE ... \033[1;33m[\033[1;31m!\033[1;33m] \033[0m"
echo ""
echo -e "      \033[1;33mFUNKCIJU UZBAIGIMAS IR APIBREZIMAI! \033[0m"
echo ""
fun_bar "$_Ink/list $_lnk $_Ink $_1nk $key"
clear
echo ""
cd $HOME
echo -e "        \033[1;33m • \033[1;32mSKRIPTO DIEGIMAS BAIGTAS\033[1;33m • \033[0m"
echo ""
echo -e "\033[1;31m \033[1;33mKOMANDA: \033[1;32mmenu\033[0m"
echo -e "\033[1;33m DAUGIAU INFORMACIJOS \033[1;31m(\033[1;36mTELEGRAM\033[1;31m): \033[1;37m@Deinternet\033[0m"
rm -f "$HOME/Plus"
