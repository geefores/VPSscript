#!/usr/bin/env bash
# SSHPLUS installer module for Ubuntu 24.04 LTS.
# Keeps the original repository directory layout and the legacy argument contract.
set -Eeuo pipefail
umask 027

readonly REPO_RAW="https://raw.githubusercontent.com/geefores/VPSscript/main/SSHPLUSsocks"
readonly MODULES_URL="${REPO_RAW}/Modulos"
readonly INSTALL_URL="${REPO_RAW}/Install"
readonly BACKUP_ROOT="/var/backups/sshplus-install"

# Legacy arguments supplied by SSHPLUSsocks/Plus.
lst="${1:-}"
lst1="${2:-}"
lst2="${3:-/usr/lib}"
key1="${4:-}"
key2="crz"

log() { printf '[SSHPLUS] %s\n' "$*"; }
die() { printf '[SSHPLUS] KLAIDA: %s\n' "$*" >&2; exit 1; }

[[ "${EUID}" -eq 0 ]] || die "Paleiskite kaip root (sudo)."
[[ -r /etc/os-release ]] || die "Nepavyko nustatyti operacinės sistemos."
# shellcheck disable=SC1091
. /etc/os-release
[[ "${ID:-}" == "ubuntu" && "${VERSION_ID:-}" == "24.04" ]] || die "Šis diegimo modulis skirtas Ubuntu 24.04 LTS."
command -v curl >/dev/null 2>&1 || die "Trūksta curl. Įdiekite: apt-get install -y curl ca-certificates"

# The original Plus script calls this file once to validate/download modules.
# If called without its normal arguments, do not erase files or shell history.
if [[ -z "$lst1" ]]; then
  log "Trūksta privalomų argumentų; niekas nebuvo ištrinta."
  exit 2
fi

# Download and validate every module before changing any system files.
modules=(
  ShellBot.sh addhost delhost alterarsenha criarusuario expcleaner mudardata remover
  sshplus-safe-restore
  criarteste verifbot droplimiter alterarlimite ajuda sshmonitor badvpn
  userbackup instsqd blockt otimizar menu speedtest banner senharoot
  reiniciarservicos reiniciarsistema attscript conexao delscript detalhes
  botssh infousers verifatt limiter uexpired cabecalho bot open.py slow_dns
  proxy.py wsproxy.py trojan-go botteste onlineapp
)

staging_dir="$(mktemp -d /tmp/sshplus-modules.XXXXXX)"
version_staged="${staging_dir}/versao"
cleanup_staging() { rm -rf -- "$staging_dir"; }
trap cleanup_staging EXIT

for module in "${modules[@]}"; do
  staged_file="${staging_dir}/${module}"
  if ! curl --fail --location --silent --show-error --retry 2 --connect-timeout 10 \
      "${MODULES_URL}/${module}" -o "$staged_file"; then
    die "Nepavyko atsisiųsti modulio ${module}; sistema nepakeista."
  fi
  [[ -s "$staged_file" ]] || die "GitHub grąžino tuščią modulį ${module}; sistema nepakeista."
  log "Patikrintas atsisiuntimas: ${module}"
done

# Version metadata is staged too; failure is non-fatal, as in the original flow.
version_ready=0
if curl --fail --location --silent --show-error --retry 2 \
    "${INSTALL_URL}/versao" -o "$version_staged" && [[ -s "$version_staged" ]]; then
  version_ready=1
fi

# No system changes happen until all required modules have been downloaded.
install -d -m 0750 \
  /etc/SSHPlus/v2ray \
  /etc/SSHPlus/senha \
  /etc/SSHPlus/userteste \
  /etc/SSHPlus/.tmp \
  /etc/bot/info-users \
  /etc/bot/arquivos \
  /etc/bot/revenda \
  /etc/bot/suspensos
install -d -m 0750 "$BACKUP_ROOT"
: >> /etc/SSHPlus/Exp
: >> /etc/bot/lista_ativos
: >> /etc/bot/lista_suspensos

# Keep a recoverable copy of files this installer is about to replace.
backup_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_dir="${BACKUP_ROOT}/${backup_stamp}"
install -d -m 0700 "$backup_dir"

backup_if_exists() {
  local path="$1" rel
  [[ -e "$path" || -L "$path" ]] || return 0
  rel="${path#/}"
  install -d -m 0700 "${backup_dir}/$(dirname "$rel")"
  cp -a -- "$path" "${backup_dir}/${rel}"
}

install_staged_module() {
  local name="$1" destination mode="${2:-0755}"
  case "$name" in
    ShellBot.sh|cabecalho|bot|open.py|proxy.py|wsproxy.py)
      destination="/etc/SSHPlus/${name}"
      ;;
    *)
      destination="/bin/${name}"
      ;;
  esac
  backup_if_exists "$destination"
  install -D -m "$mode" "${staging_dir}/${name}" "$destination"
  log "Įdiegtas modulis: ${name}"
}

# Preserve the legacy marker files used by existing modules.
backup_if_exists /usr/lib/sshplus
backup_if_exists "${lst2%/}/licence"
backup_if_exists /etc/SSHPlus/.tmp/crazy
printf '%s\n' 'by: @DEINTERNET' > /usr/lib/sshplus
install -m 0640 /usr/lib/sshplus "${lst2%/}/licence"
install -m 0640 /usr/lib/sshplus /etc/SSHPlus/.tmp/crazy

# Public IP is optional metadata. Do not contact the old HTTP host.
if public_ip="$(curl --fail --location --silent --show-error --connect-timeout 5 https://api.ipify.org 2>/dev/null)" \
   && [[ "$public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  backup_if_exists /etc/IP
  printf '%s\n' "$public_ip" > /etc/IP
fi

for module in "${modules[@]}"; do
  install_staged_module "$module"
done

# Version metadata from the same repository; it is not executable code.
if [[ "$version_ready" -eq 1 ]]; then
  backup_if_exists /bin/versao
  backup_if_exists /home/sshplus
  install -m 0644 "$version_staged" /bin/versao
  install -m 0644 "$version_staged" /home/sshplus
fi

# Create autostart only when absent; never overwrite a user's existing file.
if [[ ! -e /etc/autostart ]]; then
  cat > /etc/autostart <<'AUTOSTART_EOF'
#!/usr/bin/env bash
# SSHPLUS automatinio paleidimo failas. Moduliai gali papildyti šį failą.
AUTOSTART_EOF
  chmod 0750 /etc/autostart
fi

# Preserve unrelated cron jobs and replace only SSHPLUS-managed entries.
current_cron="$(mktemp)"
new_cron="$(mktemp)"
crontab -l 2>/dev/null > "$current_cron" || true
awk '!($0 == "@daily /bin/verifatt" || $0 == "@reboot /etc/autostart" || $0 == "* * * * * /etc/autostart" || $0 == "0 */6 * * * /bin/uexpired")' "$current_cron" > "$new_cron" || true
{
  cat "$new_cron"
  printf '%s\n' '@daily /bin/verifatt' '@reboot /etc/autostart' '0 */6 * * * /bin/uexpired'
} | awk '!seen[$0]++' | crontab -
rm -f -- "$current_cron" "$new_cron"

# Do not modify /etc/hosts, timezone, sshd_config, firewall rules, unrelated
# screen sessions, system-wide jq binary, shell history, or unrelated cron jobs.
log "Diegimo modulių paruošimas baigtas."
log "Atsarginės kopijos (jei failai buvo pakeisti): ${backup_dir}"
